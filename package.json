{
  "name": "guksu-harness",
  "version": "5.1.0",
  "description": "Claude Code·Codex의 팀 설정 관리 — 기존 설정을 보존하는 설치·업데이트, 보호 훅과 선택적 검증 도구",
  "type": "module",
  "bin": {
    "guksu-harness": "bin/guksu-harness.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "!**/*.test.mjs",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/plugins/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node skills/harness/scripts/validateHarness.mjs .",
    "test": "node --test --test-concurrency=1 skills/harness/scripts/*.test.mjs skills/fe-predeploy/scripts/*.test.mjs bin/*.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guksu/guksu-harness.git"
  },
  "homepage": "https://github.com/Guksu/guksu-harness",
  "author": "Guksu <yung3152@gmail.com>",
  "license": "MIT",
  "keywords": [
    "harness",
    "claude-code",
    "codex",
    "agent",
    "scaffold",
    "hooks",
    "skills"
  ]
}
